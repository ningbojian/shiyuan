# Copy these into your shell (or a local .env loader). Never commit real secrets.
# Development needs DJANGO_DEBUG=1 for runserver to serve static files.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production hardening: enable only behind HTTPS / a TLS-terminating proxy.
DJANGO_SECURE_SSL=0
DJANGO_HSTS_SECONDS=31536000

# Trust X-Forwarded-Proto only when a reverse proxy overwrites it.
# Leave 0 when the app is reachable directly (the header is spoofable).
DJANGO_TRUST_X_FORWARDED_PROTO=0

# WhiteNoise cache lifetime for hashed static assets (seconds, production only).
DJANGO_STATIC_MAX_AGE=31536000
